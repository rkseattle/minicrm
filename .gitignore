# ─── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.local
.env.test
.env.*.local
.env.demo
*/.env.demo
!.env.example
!.env.test.example

# ─── Node ─────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn/cache
.pnpm-store/
.eslintcache

# ─── React / Vite (client) ────────────────────────────────────────────────────
client/dist/
client/.vite/
client/build/

# ─── Server build output ──────────────────────────────────────────────────────
server/dist/
# tsc side-emits compiled shared schemas when building from server/ (MINCRM-288)
shared/schemas/*.js
shared/schemas/*.d.ts
# tsc also compiles shared/generated (buf-generated protobuf code) at build time —
# the Docker runtime image needs this .js output present alongside the checked-in .ts.
shared/generated/*.js
shared/generated/*.d.ts

# ─── Generated API spec (produced by npm run generate-spec) ───────────────────
server/openapi.json

# ─── Docker ───────────────────────────────────────────────────────────────────
# Ignore local override files but keep the base compose files
docker-compose.override.yml

# ─── Database ─────────────────────────────────────────────────────────────────
# Local Postgres data volume if mounted to a local directory
db/data/
*.sql.bak
# Backup dumps written by scripts/backup.sh (MINCRM-393)
backups/

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
pids/
*.pid
*.seed

# ─── Testing ──────────────────────────────────────────────────────────────────
coverage/
coverage-raw/
.nyc_output/
test-results/
junit.xml
playwright-report/
# MINCRM-604: runtime coverage dumps written by the backend V8 coverage agent
coverage-dumps/

# ─── QA workspace ─────────────────────────────────────────────────────────────
qa/.env
qa/node_modules/
qa/dist/
qa/playwright-report/
# MINCRM-192: storageState auth artifacts — never commit session cookies
qa/e2e/.auth/
# MINCRM-549: per-run timing log (gitignored); committed baseline is test-timing-baseline.json
qa/e2e/test-timing.jsonl
# MINCRM-661: per-run resource-touch log (gitignored). Captured by
# resource-touch-reporter.ts for future empirical validation against
# RESOURCE_REGISTRY (qa/e2e/apps/minicrm/resource-registry.ts) — not yet
# consumed by any script; the conflict-graph scheduler currently reads only
# the static registry.
qa/e2e/resource-touch.jsonl
# MINCRM-549: per-shard generated configs consumed by CI; not committed
qa/e2e/playwright.shard.config.ts
qa/e2e/playwright.shard.*.config.ts
# MINCRM-661: per-conflict-group generated configs consumed by CI; not committed
qa/e2e/playwright.serial-group.*.config.ts
qa/e2e/playwright.serial-groups.json

# ─── OS & Editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# ─── Claude Code ──────────────────────────────────────────────────────────────
# Session-specific memory files Claude Code writes locally
.claude/settings.local.json

# ─── Git ──────────────────────────────────────────────────────────────────────
*.orig
*.BACKUP.*
*.BASE.*
*.LOCAL.*
*.REMOTE.*
# CI artifact downloads (coverage reports, healing reports, test results, E2E shards)
client-coverage-*/
healing-report-*/
client-test-results-*/
server-coverage-*/
framework-test-results-*/
framework-coverage-*/
e2e-shard-*/
e2e-merged-*/

# Local implementation-planning scratch docs. Untracked by convention — these are
# working notes for a single ticket, not repo documentation, and committing them
# would put process narrative in the history. (MINCRM-689)
docs/plans/
