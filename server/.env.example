# Server-only environment variables.
# In monorepo usage the root .env is loaded automatically via dotenv/config.
# This file documents the full set of variables the server reads — copy the
# relevant ones to the root .env (or server/.env if running the server standalone).

# ─── Database ─────────────────────────────────────────────────────────────────
DB_USER=minicrm
DB_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
DB_NAME=minicrm
DB_HOST=localhost
DB_PORT=5432

# Used by node-pg-migrate CLI when running migrations directly.
# Must match the DB_* values above.
DATABASE_URL=postgres://minicrm:REPLACE_WITH_LOCAL_DB_PASSWORD@localhost:5432/minicrm

# ─── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED: Must be a cryptographically random string, minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: The server rejects 'changeme', 'secret', 'password', and '' at startup.
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Comma-separated list of allowed CORS origins.
# See root .env.example for full documentation including LAN access instructions.
CORS_ORIGIN=http://localhost:5173

# ─── E2E mode (optional) ──────────────────────────────────────────────────────
# Set to 'true' when running Playwright E2E tests locally to disable rate limiting.
# Never set in production — guarded by NODE_ENV !== 'production'.
# E2E=true

# ─── Admin seed user ──────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
