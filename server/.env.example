# Server-only environment variables.
# In monorepo usage the root .env is loaded automatically via dotenv/config.
# This file documents the full set of variables the server reads — copy the
# relevant ones to the root .env (or server/.env if running the server standalone).

# ─── Database ─────────────────────────────────────────────────────────────────
DB_USER=minicrm
DB_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
DB_NAME=minicrm
DB_HOST=localhost
DB_PORT=5432
# Maximum database connections in the pool (default: 10).
# Should not exceed PostgreSQL's max_connections minus connections reserved for other services.
# DB_POOL_MAX=10

# Used by node-pg-migrate CLI when running migrations directly.
# Must match the DB_* values above.
DATABASE_URL=postgres://minicrm:REPLACE_WITH_LOCAL_DB_PASSWORD@localhost:5432/minicrm

# ─── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED: Must be a cryptographically random string, minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: The server rejects 'changeme', 'secret', 'password', and '' at startup.
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── gRPC ─────────────────────────────────────────────────────────────────────
# Port for the gRPC AuditService (MINCRM-376). Defaults to 50051 when not set.
# GRPC_PORT=50051

# Comma-separated list of allowed CORS origins.
# See root .env.example for full documentation including LAN access instructions.
CORS_ORIGIN=http://localhost:5173

# ─── E2E mode (optional) ──────────────────────────────────────────────────────
# Set to 'true' when running Playwright E2E tests locally to disable rate limiting.
# Never set in production — guarded by NODE_ENV !== 'production'.
# E2E=true

# ─── Admin seed user ──────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ─── File storage encryption ──────────────────────────────────────────────────
# Required when using file attachments (S3 or MinIO storage).
# Must be a 64-character hex string (32 bytes) used for AES-256-GCM encryption
# of the storage secret access key at rest. Without this, configuring storage
# via the Admin Settings UI will throw an error.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NODE_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Optional in development (emails are logged to stdout instead of delivered).
# Required in production for overdue task digest emails and assignment notifications.
# Without SMTP_HOST, emails are silently skipped — no error is shown to users.
# SMTP can also be configured via Admin Settings in the UI (stored encrypted in
# the database). Environment variables serve as a fallback when no DB config is set.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=MiniCRM <notifications@example.com>

# Base URL of the client application, used to generate links in email bodies.
# Set to the URL users access the app from (e.g. https://crm.example.com).
APP_URL=http://localhost:5173

# ─── Error tracking (optional) ────────────────────────────────────────────────
# Set to enable server-side error reporting to Sentry.
# Omit to disable Sentry (e.g. local development). Automatically skipped in test.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
