{
  "apiVersion": "v1.0",
  "source": "https://learn.microsoft.com/en-us/graph/api/resources/message",
  "note": "Exactly the properties graphProvider reads off Graph JSON — $select requests these four and no more; subject, hasAttachments and the body come from the MIME document instead. Anything wider would let the fake return a field no driver behavior depends on, weakening the drift check. Microsoft publishes CSDL and OpenAPI rather than a normalizable JSON document, so unlike gmail-discovery.json this is written directly — see docs/dev/email-sync.md for what that does and does not catch.",
  "definitions": {
    "Message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "isDraft": { "type": "boolean" },
        "receivedDateTime": { "type": "string" },
        "@removed": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "reason": { "type": "string", "enum": ["changed", "deleted"] } }
        }
      }
    },
    "MailFolder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "totalItemCount": { "type": "integer" },
        "unreadItemCount": { "type": "integer" },
        "childFolderCount": { "type": "integer" },
        "isHidden": { "type": "boolean" },
        "parentFolderId": { "type": "string" }
      }
    },
    "DeltaResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "@odata.context": { "type": "string" },
        "@odata.nextLink": { "type": "string" },
        "@odata.deltaLink": { "type": "string" },
        "value": { "type": "array", "items": { "$ref": "#/definitions/Message" } }
      }
    }
  }
}
