{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "paths": {
      "@minicrm/shared/schemas/*": ["../shared/schemas/*"],
      "@minicrm/shared/generated/*": ["../shared/generated/*"],
      "@minicrm/shared/testing/*": ["../shared/testing/*"],
      "@minicrm/shared/types/*": ["../shared/types/*"]
    }
  },
  "include": ["src/**/*", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
