{
  "name": "minicrm-server",
  "version": "0.1.0",
  "description": "MiniCRM API server",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run copy-assets",
    "copy-assets": "mkdir -p dist/server/src/assets/fonts && cp src/assets/fonts/*.otf src/assets/fonts/*.txt dist/server/src/assets/fonts/",
    "start": "tsx src/server.ts",
    "dev": "nodemon --exec tsx src/server.ts",
    "migrate": "node-pg-migrate -m ../db/migrations up --no-check-order",
    "migrate:down": "node-pg-migrate -m ../db/migrations down --no-check-order",
    "migrate:fresh": "tsx src/scripts/migrate-fresh.ts",
    "db:erd": "cd .. && PGSSLMODE=disable DATABASE_URL=${DATABASE_URL:-postgres://minicrm:password@localhost:5432/minicrm} tbls doc --force",
    "typecheck": "tsc --noEmit",
    "test": "DOTENV_CONFIG_PATH=../.env.test vitest run",
    "test:coverage": "npm test -- --coverage",
    "generate-spec": "tsx src/scripts/generateSpec.ts",
    "lint:api": "npm run generate-spec && npx --yes @redocly/cli lint openapi.json",
    "seed:e2e-admin": "tsx src/scripts/seed-e2e-admin.ts",
    "seed:e2e-storage": "tsx src/scripts/seed-e2e-storage.ts",
    "seed:e2e-smtp": "tsx src/scripts/seed-e2e-smtp.ts",
    "create:e2e-db": "tsx src/scripts/create-e2e-db.ts",
    "reset:e2e-data": "tsx src/scripts/reset-e2e-data.ts",
    "create:coverage-db": "tsx src/scripts/create-coverage-db.ts",
    "select:tests": "LOG_DESTINATION=stderr tsx src/scripts/select-tests.ts",
    "load:coverage-map": "LOG_DESTINATION=stderr tsx src/scripts/load-coverage-map.ts",
    "dump:coverage-map": "LOG_DESTINATION=stderr tsx src/scripts/dump-coverage-map.ts",
    "verify:test-attestation": "LOG_DESTINATION=stderr tsx src/scripts/verify-test-attestation.ts",
    "report:coverage-map-size": "LOG_DESTINATION=stderr tsx src/scripts/report-coverage-map-size.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.55.1",
    "@bufbuild/protobuf": "1.10.1",
    "@connectrpc/connect": "1.7.0",
    "@connectrpc/connect-express": "1.7.0",
    "@connectrpc/connect-node": "1.7.0",
    "@minicrm/shared": "*",
    "@node-saml/node-saml": "5.2.0",
    "@sentry/node": "10.76.2",
    "@types/speakeasy": "2.0.10",
    "asn1js": "4.0.0",
    "bcryptjs": "3.0.3",
    "cookie": "0.7.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "csv-parse": "6.2.1",
    "docx": "9.14.0",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "html-to-text": "10.0.1",
    "imapflow": "1.7.8",
    "ipaddr.js": "1.9.1",
    "istanbul-lib-coverage": "3.2.2",
    "jsonwebtoken": "9.0.3",
    "mailparser": "3.12.4",
    "minio": "8.0.7",
    "morgan": "1.12.1",
    "multer": "2.5.0",
    "node-cron": "4.6.0",
    "node-pg-migrate": "8.0.4",
    "nodemailer": "10.2.1",
    "openid-client": "6.8.8",
    "otplib": "13.5.0",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "pkijs": "4.0.0",
    "qrcode": "1.5.4",
    "speakeasy": "2.0.0",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "typescript": "6.0.3",
    "uuid": "11.1.1",
    "v8-to-istanbul": "9.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "1.10.1",
    "@connectrpc/protoc-gen-connect-es": "1.7.0",
    "@types/bcryptjs": "2.4.6",
    "@types/cookie": "0.6.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/html-to-text": "9.0.4",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/mailparser": "3.9.0",
    "@types/morgan": "1.9.10",
    "@types/multer": "2.3.0",
    "@types/node": "25.9.9",
    "@types/node-cron": "3.0.11",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-n": "18.5.0",
    "nodemon": "3.1.14",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
