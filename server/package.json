{
  "name": "minicrm-server",
  "version": "0.1.0",
  "description": "MiniCRM API server",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/server.ts",
    "dev": "nodemon --exec tsx src/server.ts",
    "migrate": "node-pg-migrate -m ../db/migrations up",
    "migrate:down": "node-pg-migrate -m ../db/migrations down",
    "typecheck": "tsc --noEmit",
    "test": "DOTENV_CONFIG_PATH=../.env.test vitest run",
    "test:coverage": "npm test -- --coverage",
    "generate-spec": "tsx src/scripts/generateSpec.ts",
    "lint:api": "npm run generate-spec && npx --yes @redocly/cli lint openapi.json",
    "seed:e2e-admin": "tsx src/scripts/seed-e2e-admin.ts",
    "seed:e2e-storage": "tsx src/scripts/seed-e2e-storage.ts",
    "seed:e2e-smtp": "tsx src/scripts/seed-e2e-smtp.ts",
    "create:e2e-db": "tsx src/scripts/create-e2e-db.ts"
  },
  "dependencies": {
    "@minicrm/shared": "*",
    "@sentry/node": "^10.51.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "node-pg-migrate": "^8.0.4",
    "nodemailer": "^8.0.5",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.1",
    "eslint-plugin-jsdoc": "^62.8.1",
    "eslint-plugin-n": "^17.24.0",
    "nodemon": "^3.1.4",
    "tsx": "^4.21.0",
    "supertest": "^7.0.0",
    "vitest": "^4.1.1"
  }
}
