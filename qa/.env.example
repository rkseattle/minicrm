# QA environment variables — copy to qa/.env and fill in values.
# All variables are required unless marked optional.
# WARNING: Never commit qa/.env to source control.

# ─── Target Environment ────────────────────────────────────────────────────────
# Base URL of the MiniCRM frontend being tested.
# Defaults to http://localhost:5173 (Vite dev server) if not set.
E2E_BASE_URL=http://localhost:5173

# API base URL used by REST client test helpers.
# Defaults to http://localhost:3001 if not set.
E2E_API_URL=http://localhost:3001

# ─── Auth / Test Users ────────────────────────────────────────────────────────
# Credentials for the admin seed user used by TestDataManager and BVT setup.
# Must match ADMIN_EMAIL / ADMIN_PASSWORD in the app's root .env.
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD

# ─── Database ─────────────────────────────────────────────────────────────────
# Connection string for the dedicated E2E database (minicrm_e2e).
# Never point this at the production or development database.
E2E_DATABASE_URL=postgresql://minicrm:password@localhost:5432/minicrm_e2e

# ─── AI Self-Healing ──────────────────────────────────────────────────────────
# Anthropic API key used by the AI heal tier to recover broken locators.
# Obtain from https://console.anthropic.com/
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY

# ─── gRPC Client (optional) ───────────────────────────────────────────────────
# Host:port of the gRPC service under test. Leave blank if not using gRPC.
E2E_GRPC_HOST=localhost:50051

# ─── Locale (optional) ────────────────────────────────────────────────────────
# Locale code for text-based locator strategies (en | es). Defaults to 'en'.
# E2E_LOCALE=en

# ─── Trace recording (optional) ───────────────────────────────────────────────
# Enable full trace recording locally (useful for debugging a failing test).
# In CI, traces are always captured on the first retry.
# Values: on | off   Default: off
# PLAYWRIGHT_TRACE=off
