# E2E environment variables — copy to qa/e2e/.env (or qa/.env) and fill in values.
# Prefer qa/.env.example as the canonical reference; this file mirrors it for
# runners that load from qa/e2e/ directly.
# WARNING: Never commit .env files to source control.

# ─── Target Environment ────────────────────────────────────────────────────────
# Frontend origin — the URL Playwright navigates to in the browser.
# For local development this is the Vite dev server (port 5173).
# On staging this would be the public frontend URL, e.g. https://app.staging.example.com
# Port 5175 — the TEST stack's own Vite client (`npm run e2e:client`), so it can run
# alongside the dev UI on 5173 instead of fighting it for the port. CI sets this
# variable itself (to 5173, where it starts its own client), so this is local-only.
# (MINCRM-684)
E2E_BASE_URL=http://localhost:5175

# Backend API origin — used by RestClient, globalSetup, and any test helper that
# calls the API directly (bypassing the browser / Vite proxy).
# MINCRM-330: must point at the dedicated E2E server (port 3002, DB=minicrm_e2e),
# not the dev server (port 3001, DB=minicrm). Start it with:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml --profile e2e up -d
# MINCRM-556: start the Vite dev server with `npm run e2e:client` (or
# `npm run dev:e2e --workspace=minicrm-client`) so the browser proxy also targets
# port 3002. Using plain `npm run dev` sends browser requests to port 3001 instead.
# On staging this would differ from E2E_BASE_URL, e.g. https://api.staging.example.com
E2E_API_URL=http://localhost:3002

# ─── Auth / Test Users ────────────────────────────────────────────────────────
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD

# ─── Database ─────────────────────────────────────────────────────────────────
# MINCRM-559: used by globalSetup's stale-data guard (local runs only).
# If the user count exceeds 500, a warning is printed; above 2000, the run is aborted.
# Run `npm run e2e:setup` to reset the E2E database before each local session.
# Port 5433 — the isolated test Postgres (docker-compose.test.yml). NOT 5432: that is
# the dev database, and minicrm_e2e no longer exists there. (MINCRM-684)
E2E_DATABASE_URL=postgresql://minicrm:password@localhost:5433/minicrm_e2e

# ─── AI Self-Healing ──────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY is required to enable the AI healing tier.
# When unset, AI healing is disabled and only static strategy fallback is used.
# Each AI heal consumes tokens (input + output) from your API quota.
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY

# Set to 'true' to activate the AI healing tier (requires ANTHROPIC_API_KEY).
# When absent or empty the AI tier is skipped entirely — opt-in only.
# Developers running the suite locally without AI_HEALING set get static-only behavior.
AI_HEALING=true

# Emit a CI warning when the number of AI heals in a run exceeds this threshold.
# Defaults to 50 when not set. CI uses 20 for initial activation (conservative).
# AI_HEAL_COST_WARNING_THRESHOLD=20

# ─── gRPC Client (optional) ───────────────────────────────────────────────────
E2E_GRPC_HOST=localhost:50051

# ─── Locale (optional) ────────────────────────────────────────────────────────
# E2E_LOCALE=en

# ─── Trace recording (optional) ───────────────────────────────────────────────
# Values: on | off   Default: off
# PLAYWRIGHT_TRACE=off

# ─── Database (host coordinates for e2e:setup and its child scripts) ──────────
# MUST be set here. scripts/e2e-setup.ts loads the root .env for NODE_ENCRYPTION_KEY,
# and that file necessarily sets DB_PORT=5432 for the dev stack — without an explicit
# value here, every E2E setup child would inherit the dev port. (MINCRM-684)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=minicrm_e2e
COVERAGE_DB_NAME=minicrm_coverage_e2e

# Auth cookie name for the TEST stack. Cookies are scoped by domain, not port, so the
# dev stack (localhost:5173) and this one (localhost:5175) would otherwise share a jar
# and clobber each other's session. Must match AUTH_COOKIE_NAME in
# docker-compose.test.yml. (MINCRM-684)
AUTH_COOKIE_NAME=minicrm_token_test
