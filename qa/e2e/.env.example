# E2E environment variables — copy to .env and fill in values.
# Never commit .env to source control.

# Target application URL (defaults to http://localhost:5173 if unset)
E2E_BASE_URL=http://localhost:5173

# API URL used by test data setup helpers (defaults to http://localhost:3001)
E2E_API_URL=http://localhost:3001

# Admin credentials for test data setup
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Enable full trace recording locally (useful for debugging a specific failing test).
# In CI, traces are always captured on the first retry (on-first-retry).
# Locally, set to 'on' to capture traces without editing playwright.config.ts.
# Values: on | off
PLAYWRIGHT_TRACE=off
