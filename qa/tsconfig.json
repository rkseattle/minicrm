{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "..",
    "baseUrl": ".",
    "paths": {
      "@framework/*": ["e2e/framework/*"],
      "@pages/*": ["e2e/pages/*"],
      "@behaviors/*": ["e2e/behaviors/*"],
      "@apps/*": ["e2e/apps/*"],
      "@minicrm/shared/schemas/*": ["../shared/schemas/*"],
      "@minicrm/shared/testing/*": ["../shared/testing/*"]
    }
  },
  "include": ["e2e/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
