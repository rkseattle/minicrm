{
  "name": "minicrm-qa",
  "version": "0.1.0",
  "private": true,
  "description": "Self-healing Playwright test automation framework for MiniCRM (MINCRM-106)",
  "scripts": {
    "test": "playwright test --config=e2e/playwright.config.ts",
    "test:desktop": "playwright test --config=e2e/playwright.config.ts --project=desktop",
    "test:mobile": "playwright test --config=e2e/playwright.config.ts --project=mobile-web",
    "test:headed": "playwright test --config=e2e/playwright.config.ts --headed",
    "test:framework": "playwright test --config=e2e/playwright.config.ts --project=desktop e2e/tests/framework/ e2e/tests/apps/minicrm/resource-registry.spec.ts e2e/tests/apps/minicrm/build-conflict-graph.spec.ts e2e/tests/apps/minicrm/gen-conflict-group-configs.spec.ts e2e/tests/apps/minicrm/test-data-manager.spec.ts e2e/tests/apps/minicrm/mail-fakes.spec.ts",
    "test:framework:coverage": "NODE_V8_COVERAGE=./coverage-raw playwright test --config=e2e/playwright.config.ts --project=desktop e2e/tests/framework/ e2e/tests/apps/minicrm/resource-registry.spec.ts e2e/tests/apps/minicrm/build-conflict-graph.spec.ts e2e/tests/apps/minicrm/gen-conflict-group-configs.spec.ts e2e/tests/apps/minicrm/test-data-manager.spec.ts e2e/tests/apps/minicrm/mail-fakes.spec.ts && npx c8 report --temp-directory ./coverage-raw --src e2e/framework --include 'e2e/framework/**/*.ts' --exclude 'e2e/tests/**' --reporter text --reporter lcov --reporter json-summary --reports-dir coverage --check-coverage --lines 80 --functions 80 --branches 80 --statements 80",
    "test:perf": "playwright test --config=e2e/playwright.config.ts --project=perf",
    "lint:framework-purity": "bash scripts/check-framework-purity.sh",
    "lint:behavior-layer": "bash scripts/check-behavior-layer.sh",
    "lint:beforeall": "bash scripts/check-e2e-beforeall.sh",
    "lint:e2e-cleanup": "bash scripts/check-e2e-cleanup.sh",
    "typecheck": "tsc --noEmit",
    "migrate:coverage": "node-pg-migrate -m migrations up --no-check-order",
    "migrate:coverage:down": "node-pg-migrate -m migrations down --no-check-order",
    "create:coverage-e2e-db": "tsx scripts/create-coverage-e2e-db.ts",
    "ingest:coverage-dumps": "tsx e2e/scripts/ingest-coverage-dumps.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@axe-core/playwright": "4.14.0",
    "@grpc/grpc-js": "1.14.6",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@typescript-eslint/typescript-estree": "8.72.1",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "node-pg-migrate": "9.0.0",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "promptfoo": "0.125.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
