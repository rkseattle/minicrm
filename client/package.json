{
  "name": "minicrm-client",
  "version": "0.1.0",
  "description": "MiniCRM React client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:dev-stack": "echo '\u2192 DEV stack: API http://localhost:3001, UI http://localhost:5173 (or http://dev.minicrm.local:5173)' && cross-env API_URL=http://localhost:3001 DEV_ALLOWED_HOSTS=dev.minicrm.local vite",
    "dev:e2e": "echo '\u2192 TEST stack: API http://localhost:3002, UI http://localhost:5173 (matches CI)' && cross-env API_URL=http://localhost:3002 vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.1",
    "@connectrpc/connect": "^1.7.0",
    "@connectrpc/connect-web": "^1.7.0",
    "@lexical/code": "^0.44.0",
    "@lexical/html": "^0.44.0",
    "@lexical/link": "^0.44.0",
    "@lexical/list": "^0.44.0",
    "@lexical/react": "^0.44.0",
    "@lexical/rich-text": "^0.44.0",
    "@lexical/selection": "^0.44.0",
    "@lexical/utils": "^0.44.0",
    "@sentry/react": "^10.51.0",
    "@tanstack/react-query": "^5.51.1",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@types/diff": "^7.0.2",
    "axios": "^1.15.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.2",
    "i18next": "^23.12.2",
    "lexical": "^0.44.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.1",
    "autoprefixer": "^10.4.27",
    "cross-env": "^10.1.0",
    "eslint-plugin-i18next": "^6.1.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.0.1",
    "msw": "^2.12.14",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.16",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^4.1.1"
  }
}
