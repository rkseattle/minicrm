{
  "name": "minicrm-client",
  "version": "0.1.0",
  "description": "MiniCRM React client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:dev-stack": "echo '→ DEV stack: API http://localhost:3001, UI http://localhost:5173 (or http://dev.minicrm.local:5173)' && cross-env API_URL=http://localhost:3001 DEV_ALLOWED_HOSTS=dev.minicrm.local vite",
    "dev:e2e": "echo '→ TEST stack: API http://localhost:3002, UI http://localhost:5175' && cross-env API_URL=http://localhost:3002 vite --port 5175 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@lexical/html": "0.52.0",
    "@lexical/list": "0.52.0",
    "@lexical/react": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@lexical/selection": "0.52.0",
    "@lexical/utils": "0.52.0",
    "@sentry/core": "11.9.0",
    "@sentry/react": "11.9.0",
    "@tanstack/react-query": "5.105.0",
    "axios": "1.20.0",
    "diff": "9.0.0",
    "dompurify": "3.4.17",
    "email-addresses": "5.0.0",
    "i18next": "26.5.11",
    "lexical": "0.52.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "cross-env": "10.1.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "vite-plugin-istanbul": "9.0.1",
    "vitest": "5.0.5"
  }
}
