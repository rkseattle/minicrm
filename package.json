{
  "name": "minicrm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "//engines": "DECLARATIVE, not enforced. npm honours engines only under engine-strict, and no .npmrc sets it \u2014 deliberately: 82 packages in the tree declare node >= 22 and would turn every npm ci into a hard failure. CI pins the real floor via .nvmrc + setup-node. (MINCRM-704)",
  "//packageManager": "Also declarative \u2014 nothing here enables Corepack. Records the npm that ships with the node version .nvmrc pins (node:24-alpine -> npm 11.17.0), which is what CI actually runs. (MINCRM-704)",
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "shared",
    "server",
    "client",
    "qa",
    "coverage-dashboard"
  ],
  "scripts": {
    "prepare": "husky || true",
    "unit_test": "npm test --workspace=minicrm-server && npm test --workspace=minicrm-client && npm test --workspace=minicrm-coverage-dashboard",
    "typecheck": "npm run typecheck --workspace=minicrm-server && npm run typecheck --workspace=minicrm-client && npm run typecheck --workspace=minicrm-qa && npm run typecheck --workspace=minicrm-coverage-dashboard && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint . --cache --cache-location .eslintcache --cache-strategy content",
    "format": "prettier --write .",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "remove:demo": "tsx scripts/remove-demo.ts",
    "seed:e2e-admin": "npm run seed:e2e-admin --workspace=minicrm-server",
    "seed:e2e-storage": "npm run seed:e2e-storage --workspace=minicrm-server",
    "seed:e2e-smtp": "npm run seed:e2e-smtp --workspace=minicrm-server",
    "create:e2e-db": "npm run create:e2e-db --workspace=minicrm-server",
    "reset:e2e-data": "npm run reset:e2e-data --workspace=minicrm-server",
    "e2e:setup": "npx tsx scripts/e2e-setup.ts",
    "dev:client": "npm run dev:dev-stack --workspace=minicrm-client",
    "e2e:client": "npm run dev:e2e --workspace=minicrm-client",
    "screenshot": "tsx scripts/screenshot.ts",
    "pseudoloc": "tsx scripts/generate-pseudoloc.ts",
    "audit:testids": "tsx qa/scripts/check-testids.ts",
    "audit:testids:self-test": "tsx qa/scripts/check-testids.ts --self-test",
    "generate:proto": "npx @bufbuild/buf generate",
    "e2e:timing:baseline": "npx tsx qa/e2e/scripts/compute-timing-baseline.ts",
    "e2e:timing:shards": "npx tsx qa/e2e/scripts/gen-shards.ts",
    "e2e:timing:gen-config": "npx tsx qa/e2e/scripts/gen-shard-config.ts",
    "e2e:timing:hotspots": "npx tsx qa/e2e/scripts/find-hotspots.ts",
    "e2e:capacity-plan": "npx tsx qa/e2e/scripts/print-capacity-plan.ts",
    "eval": "bash qa/evals/run-evals.sh",
    "pre-push:tia": "npx tsx scripts/pre-push-tia.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ],
    "!(docs/schema/**).md": [
      "markdownlint-cli2"
    ],
    ".github/workflows/*.{yml,yaml}": [
      "actionlint"
    ]
  },
  "overrides": {
    "undici": "7.29.0",
    "markdownlint-cli2": {
      "js-yaml": "4.3.1",
      "markdown-it": "14.2.0"
    },
    "onnxruntime-node": {
      "adm-zip": "0.6.0"
    },
    "sharp": "0.35.3",
    "@hono/node-server": "2.0.11",
    "promptfoo": {
      "hono": "4.12.34"
    },
    "fast-uri": "3.1.7",
    "qs": "6.16.0",
    "@xmldom/xmldom": "0.9.12",
    "decode-uri-component": "0.5.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@typescript-eslint/typescript-estree": "^8.57.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "markdownlint-cli2": "^0.23.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.0.3"
  },
  "dependencies": {
    "@node-saml/node-saml": "^5.1.0"
  }
}
