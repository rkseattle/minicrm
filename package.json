{
  "name": "minicrm",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client",
    "qa"
  ],
  "scripts": {
    "prepare": "husky || true",
    "typecheck": "npm run typecheck --workspace=minicrm-server && npm run typecheck --workspace=minicrm-client && npm run typecheck --workspace=minicrm-qa",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "remove:demo": "tsx scripts/remove-demo.ts",
    "seed:e2e-admin": "npm run seed:e2e-admin --workspace=minicrm-server",
    "seed:e2e-storage": "npm run seed:e2e-storage --workspace=minicrm-server",
    "seed:e2e-smtp": "npm run seed:e2e-smtp --workspace=minicrm-server",
    "create:e2e-db": "npm run create:e2e-db --workspace=minicrm-server",
    "e2e:setup": "npx tsx scripts/e2e-setup.ts",
    "screenshot": "tsx scripts/screenshot.ts",
    "pseudoloc": "tsx scripts/generate-pseudoloc.ts",
    "audit:testids": "tsx qa/scripts/audit-testids.ts",
    "generate:proto": "npx @bufbuild/buf generate"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2"
    ]
  },
  "overrides": {
    "@connectrpc/connect-node": {
      "undici": "6.25.0"
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@node-saml/node-saml": "^5.1.0"
  }
}
