{
  "name": "minicrm",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client",
    "qa"
  ],
  "scripts": {
    "prepare": "husky || true",
    "typecheck": "npm run typecheck --workspace=minicrm-server && npm run typecheck --workspace=minicrm-client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "remove:demo": "tsx scripts/remove-demo.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  }
}
