# Test environment variables — copy to .env.test and fill in your values.
# CI sets these via the env: block in .github/workflows/ci.yml — no .env.test needed there.
#
# WARNING: Never commit .env.test — it is listed in .gitignore.

# ─── Database ─────────────────────────────────────────────────────────────────
DB_USER=minicrm
# Set this to your local Postgres password for the minicrm user.
DB_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
DB_NAME=minicrm_test
DB_HOST=localhost
DB_PORT=5432

# ─── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED: Must be a cryptographically random string, minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NOTE: The startup guard in server.ts rejects 'changeme', 'secret', 'password',
#       and '' — tests import app.ts directly so the guard doesn't fire, but use a
#       real random value here anyway to keep the test environment consistent.
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=test
PORT=3001
