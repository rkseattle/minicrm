# Test environment variables — copy to .env.test and fill in your values.
# CI sets these via the env: block in .github/workflows/ci.yml — no .env.test needed there.
#
# WARNING: Never commit .env.test — it is listed in .gitignore.

# ─── Database ─────────────────────────────────────────────────────────────────
DB_USER=minicrm
# Set this to your local Postgres password for the minicrm user.
DB_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
DB_NAME=minicrm_test
DB_HOST=localhost
# Isolated test Postgres published by docker-compose.test.yml. NOT 5432 — that is the
# dev database, and this suite truncates tables in beforeEach. Start it with:
#   docker compose -f docker-compose.test.yml up -d
# (MINCRM-684)
DB_PORT=5433

# Coverage/TIA tables live in their own database — see server/src/coverageDb.ts.
# Set this explicitly: it has no DB_NAME fallback, and the two consumers disagree on a
# default — coverageDb.ts falls back to 'minicrm_coverage', while vitest's globalSetup.ts
# falls back to 'minicrm_coverage_test'. Unset, the pool looks for minicrm_coverage on
# the test Postgres above, which does not exist there (that database lives on the dev
# stack's 5432), so the failure is a connection error rather than silent corruption.
COVERAGE_DB_NAME=minicrm_coverage_test

# ─── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED: Must be a cryptographically random string, minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NOTE: The startup guard in server.ts rejects 'changeme', 'secret', 'password',
#       and '' — tests import app.ts directly so the guard doesn't fire, but use a
#       real random value here anyway to keep the test environment consistent.
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=test
PORT=3001

# ─── Coverage/TIA (MINCRM-663) ────────────────────────────────────────────────
# Coverage/TIA control API and session management routes are registered only
# when these are 'true' at process boot — required for the integration tests
# exercising those routes to reach them at all.
COVERAGE_INSTRUMENTATION=true
COVERAGE_SESSION_MANAGEMENT=true

# ─── Encryption (MINCRM-169, startup validation MINCRM-301) ──────────────────
# REQUIRED: 64-character hex string (32 bytes) for AES-256-GCM in the
# attachmentService and cryptoService tests. Those suites fail without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_STRING
