{
  "name": "minicrm-coverage-dashboard",
  "version": "0.1.0",
  "description": "Standalone Coverage/TIA reporting dashboard — external client of minicrm-server's coverage reporting query API. No shared route table, DB access, or codebase with minicrm-client/minicrm-server. (MINCRM-628/629)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "axios": "1.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "10.6.2",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
