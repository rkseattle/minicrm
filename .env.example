# Copy to .env and fill in your values before running locally.
# All variables are required unless marked optional.

# ─── Database ─────────────────────────────────────────────────────────────────
DB_USER=minicrm
DB_PASSWORD=changeme
DB_NAME=minicrm
DB_HOST=localhost
DB_PORT=5432

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=changeme

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Admin seed user (created on first boot if no admin exists) ───────────────
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=changeme
