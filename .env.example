# Copy to .env and fill in your values before running locally.
# All variables are required unless marked optional.

# ─── Database ─────────────────────────────────────────────────────────────────
DB_USER=minicrm
DB_PASSWORD=changeme
DB_NAME=minicrm
DB_HOST=localhost
DB_PORT=5432

# ─── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED: Must be a cryptographically random string, minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Never use 'changeme' or any short/guessable value in any environment.
#          Using a weak secret allows attackers to forge valid JWTs for any role.
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Comma-separated list of allowed CORS origins. Defaults to the Vite dev server.
# Set to your deployed frontend URL in staging/production (e.g. https://app.example.com).
#
# LAN access (mobile devices on the same network):
#   When a device connects via the server's LAN IP (e.g. http://192.168.1.100:5173),
#   the browser sends that IP as the CORS origin. Add it to this list alongside
#   localhost to allow LAN access without opening a wildcard.
#   Example: CORS_ORIGIN=http://localhost:5173,http://192.168.1.100:5173
#
# Never use '*' here — credentials (cookies) require explicit origins.
CORS_ORIGIN=http://localhost:5173

# ─── Admin seed user (created on first boot if no admin exists) ───────────────
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
# REQUIRED: Must meet the application password policy (8+ chars, 1 letter, 1 number).
# WARNING: Do not use 'changeme' — this admin account is created on first boot.
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
